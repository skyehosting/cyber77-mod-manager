{
  "name": "cyber-mod-manager",
  "productName": "Cyber Mod Manager",
  "version": "1.1.0",
  "description": "Nexus Mods downloader and mod manager for Cyberpunk 2077",
  "main": "src/main.js",
  "desktopName": "edgerunners-mod-manager.desktop",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --require ./test/setup.cjs --test test/*.test.js",
    "check-secrets": "node tools/check-secrets.js",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "electron-updater": "6.8.10",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.17.0"
  },
  "overrides": {
    "@ghostery/adblocker": "2.20.1",
    "@ghostery/adblocker-electron-preload": "2.20.1",
    "@ghostery/adblocker-content": "2.20.1",
    "@ghostery/adblocker-extended-selectors": "2.20.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skyehosting/edgerunners-mod-manager.git"
  },
  "author": "skyehosting",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://skyehosting.github.io/edgerunners-mod-manager/",
  "build": {
    "appId": "io.github.skyehosting.cybermodmanager",
    "productName": "Cyber Mod Manager",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE.md",
      "NOTICE.md",
      "!**/*.map"
    ],
    "extraFiles": [
      { "from": "LICENSE.md", "to": "LICENSE.md" },
      { "from": "NOTICE.md", "to": "NOTICE.md" }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "build/7zip",
          "to": "7zip",
          "filter": [
            "7z.exe",
            "7z.dll",
            "License.txt"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Edgerunners-Mod-Manager-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Cyber Mod Manager",
      "uninstallDisplayName": "Edgerunners Mod Manager"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "edgerunners-mod-manager",
      "artifactName": "Edgerunners-Mod-Manager-${version}.${ext}",
      "synopsis": "Mod manager for Cyberpunk 2077",
      "description": "Nexus Mods downloader and mod manager for Cyberpunk 2077 (Steam, under Proton).",
      "maintainer": "skyehosting <35385976+skyehosting@users.noreply.github.com>",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Edgerunners Mod Manager",
          "Comment": "Mod manager for Cyberpunk 2077"
        }
      }
    },
    "deb": {
      "packageName": "edgerunners-mod-manager",
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0", "7zip | p7zip-full"],
      "recommends": ["libappindicator3-1", "7zip-rar | p7zip-rar"]
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "skyehosting",
        "repo": "edgerunners-mod-manager",
        "releaseType": "release"
      }
    ]
  }
}
